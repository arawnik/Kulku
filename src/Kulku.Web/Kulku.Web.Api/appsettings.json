{
  "LoggingOptions": {
    "WriteToConsole": true,
    "WriteToFile": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "Kulku.Api",
    "TracesEnabled": true,
    "MetricsEnabled": true,
    "LogsEnabled": false
  }
}
