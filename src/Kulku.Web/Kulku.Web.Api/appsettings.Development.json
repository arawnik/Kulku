{
  "LoggingOptions": {
    "WriteToFile": true,
    "LogDirectory": "../../../logs",
    "FileNamePrefix": "api"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Observability": {
    "LogsEnabled": true
  }
}
