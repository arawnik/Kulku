{
  "LoggingOptions": {
    "WriteToConsole": true,
    "WriteToFile": false,
    "FileNamePrefix": "admin"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "Kulku.Admin",
    "TracesEnabled": true,
    "MetricsEnabled": true,
    "LogsEnabled": false
  },
  "Management": {
    "MigrateOnStart": false,
    "RegistrationEnabled": false,
    "ContactUrl": "https://yourdomain.com/contact"
  },
  "AllowedHosts": "*"
}
