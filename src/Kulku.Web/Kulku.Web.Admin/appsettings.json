{
  "LoggingOptions": {
    "WriteToConsole": true,
    "WriteToFile": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Management": {
    "MigrateOnStart": false,
    "RegistrationEnabled": false,
    "ContactUrl": "https://yourdomain.com/contact"
  },
  "AllowedHosts": "*"
}
