{
  "LoggingOptions": {
    "WriteToFile": true,
    "LogDirectory": "../../../logs",
    "FileNamePrefix": "admin"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Management": {
    "MigrateOnStart": true,
    "RegistrationEnabled": false,
    "ContactUrl": "http://localhost:3000/contact"
  },
  "Assets": {
    //"BaseUrl": "http://localhost:3000/static"//,
    "LocalPath": "../kulku.web.client/public/static"
  }
}
